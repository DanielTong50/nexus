# Application
APP_NAME=nexus
APP_ENV=development
DEBUG=true

# MongoDB
#WILL SET UP LATER -DTONG
MONGODB_URI= set-up-later
MONGODB_DATABASE=nexus

# Redis (added just cause it could make things a lot easier)
REDIS_URL=redis://localhost:6379/0

# Google AI (Gemini)
#WILL SET UP LATER -DTONG
GOOGLE_API_KEY=your-google-api-key

# LLM Model Configuration
#WILL SET UP LATER -DTONG
CLASSIFIER_MODEL=gemini-2.0-flash
AGENT_MODEL=gemini-2.0-flash

# External Services (for all the additional integrations)
#WILL SET UP LATER -DTONG
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json
GITHUB_TOKEN=ghp_your-github-token
FIGMA_ACCESS_TOKEN=your-figma-access-token
CALENDLY_API_KEY=your-calendly-api-key

# Server (default and shi)
HOST=0.0.0.0
PORT=8000